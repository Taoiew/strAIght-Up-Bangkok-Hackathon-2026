# Local Docker mode
# 1. Copy this file to .env.local
# 2. Fill OPENAI_API_KEY and AUTH_SECRET
# 3. Run: npm run db:local:up
# 4. Run: npm run db:migrate
# 5. Run: npm run dev

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_OUTPUT_TOKENS=1200

DATABASE_URL=postgresql://hackathon:hackathon@localhost:5432/hackathon_starter?schema=public

AUTH_SECRET=local-dev-auth-secret-change-before-production-321
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_AGENT_STEPS=8
